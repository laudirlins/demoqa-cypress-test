{
  "name": "demoqa-cypress-cucumber",
  "version": "1.0.0",
  "private": true,
  "description": "DemoQA API and UI automation with Cypress, Cucumber, and JavaScript",
  "scripts": {
    "test:backend": "cypress run --spec \"cypress/e2e/bookstore/**/*.feature\"",
    "test:backend:open": "cypress open --e2e --spec \"cypress/e2e/bookstore/**/*.feature\"",
    "test:frontend": "cypress run --spec \"cypress/e2e/{elements,forms,interactions,widgets,windows}/**/*.feature\"",
    "test:frontend:open": "cypress open --e2e --spec \"cypress/e2e/{elements,forms,interactions,widgets,windows}/**/*.feature\"",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^22.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.4",
    "cypress": "^14.5.4",
    "esbuild": "^0.25.0"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/[filepath].{js,ts}",
      "cypress/e2e/[filepath]/**/*.{js,ts}",
      "cypress/support/step_definitions/**/*.{js,ts}"
    ]
  }
}